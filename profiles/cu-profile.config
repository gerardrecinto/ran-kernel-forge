# 5G CU (Central Unit) kernel config fragment
# Target: High-throughput PDCP/RRC/SDAP processing — not hard-RT
# Optimized for packet throughput over scheduling determinism
#
# Reference: 3GPP TS 38.401 (NG-RAN architecture)

# --- Preemption (voluntary — throughput over jitter) ---
CONFIG_PREEMPT_VOLUNTARY=y
# CONFIG_PREEMPT_RT is not set

# --- Tickless idle ---
CONFIG_NO_HZ=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HZ_250=y
CONFIG_HZ=250

# --- SR-IOV for high-speed NIC virtualization ---
CONFIG_PCI_IOV=y
CONFIG_PCI_PASID=y
CONFIG_VFIO=y
CONFIG_VFIO_PCI=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_INTEL_IOMMU=y
CONFIG_AMD_IOMMU=y

# --- Hugepages ---
CONFIG_HUGETLBFS=y
CONFIG_HUGETLB_PAGE=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y

# --- NUMA ---
CONFIG_NUMA=y
CONFIG_NUMA_BALANCING=y

# --- Network QoS (BFQ + FQ_CODEL for QUIC/NGAP) ---
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_BFQ=y
CONFIG_NET_SCH_MQPRIO=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y

# --- XDP / eBPF for NGAP acceleration ---
CONFIG_BPF_JIT=y
CONFIG_XDP_SOCKETS=y
CONFIG_BPF_SYSCALL=y
