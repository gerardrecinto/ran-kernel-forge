# 5G DU (Distributed Unit) kernel config fragment
# Target: Real-time L1/L2 baseband processing on x86_64
# Apply with: scripts/apply-profile.sh profiles/du-profile.config <kernel-src>
#
# Reference: 3GPP TS 38.211, O-RAN.WG4.MP.0-v09.00
# Validated on: linux-6.1-rt, linux-6.6-rt

# --- Real-time preemption ---
CONFIG_PREEMPT_RT=y
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_NONE is not set
# CONFIG_PREEMPT_VOLUNTARY is not set

# --- Tickless operation (full dynticks on isolated CPUs) ---
CONFIG_NO_HZ=y
CONFIG_NO_HZ_FULL=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000

# --- RCU offload (prevent RCU callbacks on isolated CPUs) ---
CONFIG_RCU_NOCB_CPU=y
CONFIG_RCU_NOCB_CPU_DEFAULT_ALL=y

# --- CPU isolation ---
CONFIG_CPU_ISOLATION=y
CONFIG_IRQ_FORCED_THREADING=y
CONFIG_TICK_CPU_ACCOUNTING=y

# --- DPDK / PMD support ---
CONFIG_VFIO=y
CONFIG_VFIO_PCI=y
CONFIG_VFIO_NOIOMMU=y
CONFIG_UIO=y
CONFIG_UIO_PCI_GENERIC=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_INTEL_IOMMU=y
CONFIG_AMD_IOMMU=y

# --- Hugepages (required for DPDK memory) ---
CONFIG_HUGETLBFS=y
CONFIG_HUGETLB_PAGE=y
CONFIG_TRANSPARENT_HUGEPAGE=y
# CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS is not set
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# --- High-resolution timers ---
CONFIG_HIGH_RES_TIMERS=y
CONFIG_HRTIMER_RESOLUTION_NS=200

# --- NUMA awareness ---
CONFIG_NUMA=y
CONFIG_NUMA_BALANCING=y

# --- Network (QoS for baseband data path) ---
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_MQPRIO=y
