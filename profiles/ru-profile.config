# 5G/6G RU (Radio Unit) kernel config fragment
# Target: eCPRI fronthaul (O-RAN 7.2x split), sub-100us jitter
# Requires PREEMPT_RT + PTP hardware timestamping + TSN
#
# Reference: O-RAN.WG4.CUS.0-v13.0, IEEE 802.1Qbv (TSN), ITU-T G.8275.1

# --- Hard real-time (mandatory for fronthaul timing) ---
CONFIG_PREEMPT_RT=y
CONFIG_PREEMPT=y

# --- Full dynticks on fronthaul CPUs ---
CONFIG_NO_HZ=y
CONFIG_NO_HZ_FULL=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000

# --- RCU offload ---
CONFIG_RCU_NOCB_CPU=y
CONFIG_RCU_NOCB_CPU_DEFAULT_ALL=y

# --- CPU isolation ---
CONFIG_CPU_ISOLATION=y
CONFIG_IRQ_FORCED_THREADING=y

# --- PTP / IEEE 1588 (fronthaul clock sync) ---
CONFIG_PTP_1588_CLOCK=y
CONFIG_PTP_1588_CLOCK_OPTIONAL=y
CONFIG_NET_PTP_CLASSIFY=y

# --- TSN (Time-Sensitive Networking for eCPRI) ---
CONFIG_NET_SCH_ETF=y
CONFIG_NET_SCH_TAPRIO=y
CONFIG_NET_SCH_MQPRIO=y

# --- SR-IOV (fronthaul NIC passthrough) ---
CONFIG_PCI_IOV=y
CONFIG_VFIO=y
CONFIG_VFIO_PCI=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_INTEL_IOMMU=y
CONFIG_AMD_IOMMU=y

# --- Hugepages ---
CONFIG_HUGETLBFS=y
CONFIG_HUGETLB_PAGE=y

# --- High-resolution timers ---
CONFIG_HIGH_RES_TIMERS=y
CONFIG_HRTIMER_RESOLUTION_NS=100
